# Elite Modell — exemplo sem credenciais reais.
# Copie para .env.local e preencha fora do controle de versao.

DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
AUTH_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

RESEND_API_KEY=""
EMAIL_FROM="Elite Modell <noreply@example.invalid>"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

ASAAS_ENVIRONMENT="sandbox"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""

KYC_PROVIDER=""
DIDIT_API_KEY=""
DIDIT_WEBHOOK_SECRET=""
PERSONA_API_KEY=""
PERSONA_WEBHOOK_SECRET=""

CAPTCHA_PROVIDER=""
RECAPTCHA_SECRET_KEY=""
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

UPLOAD_AV_ASYNC_ENABLED="false"
UPLOAD_AV_PROVIDER="HTTP"
AV_ENABLED="true"
AV_HTTP_ENDPOINT=""
AV_TIMEOUT_MS="30000"
UPLOAD_QUARANTINE_BUCKET="upload-quarantine"
APPROVED_MEDIA_BUCKET="approved-media"
MEDIA_STORAGE_PROVIDER="SUPABASE"
CRON_SECRET=""

# Nunca use NEXT_PUBLIC_ para service-role, tokens, senhas ou chaves privadas.
